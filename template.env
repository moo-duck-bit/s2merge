# Copy to .env and fill in.

# --- Hosted API backend (only needed when running with a hosted model) ---
BASE_URL=""
API_KEY=""

# --- Local vLLM backend (used for all reported experiments) ---
# LLAMA_MODEL_ID must match the --model argument passed to `vllm serve`,
# because the vLLM OpenAI-compatible endpoint keys models by that string.
VLLM_HOST="http://localhost:6789"
VLLM_BASE_URL="http://localhost:6789/v1"
VLLM_API_KEY="EMPTY"
LLAMA_MODEL_ID="meta-llama/Llama-3.1-8B-Instruct"
